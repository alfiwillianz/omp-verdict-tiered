    "tool-call",
    "classifier",
    "ai-agent",
    "jev",
    "typesafe",
    "system-one",
    "decisions",
    "onnx",
    "lancet"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "setup:lancet": "bun scripts/setup-lancet.ts",
    "build": "tsc --noEmit -p tsconfig.json"
  },
  "type": "module",
  "omp": {
