{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "extensions/**/*.ts",
    "src/**/*.ts",
    "scripts/**/*.ts"
  ]
}
